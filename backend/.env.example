# ============================================================
# CyberMilo API — environment
#
# Copy to backend/.env and fill in. `npm start` refuses to boot in
# production if any of the security-critical values are missing or left
# at their defaults (see src/lib/env.js).
# ============================================================

NODE_ENV=development
PORT=5000

# ── Security ────────────────────────────────────────────────
# Required. Use a long random value:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins. No wildcards.
FRONTEND_ORIGIN=http://localhost:5173

# Set to 1 when the API sits behind a reverse proxy or load balancer, so
# rate limiting sees the real client IP rather than the proxy's.
TRUST_PROXY=

# ── Database ────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cybermilo
MYSQL_POOL_SIZE=10

# ── Uploads ─────────────────────────────────────────────────
# Directory is created on boot and served read-only at /uploads.
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=10485760
# Set when files are fronted by a CDN or a separate domain.
UPLOAD_PUBLIC_BASE_URL=

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20

# ── Logging ─────────────────────────────────────────────────
# morgan format: dev | combined | common | short | tiny
LOG_FORMAT=dev

# ── Email (optional) ────────────────────────────────────────
# Leave blank to disable — invites then fall back to returning the
# temporary password in the API response instead of emailing it.
# For Gmail: use an App Password (myaccount.google.com/apppasswords), not
# your normal password — Gmail rejects plain-password SMTP logins.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=CyberMilo
SMTP_FROM_EMAIL=
# Base URL used to build links inside emails (e.g. the "Sign in" button).
# Defaults to the first FRONTEND_ORIGIN entry above when unset.
APP_URL=http://localhost:5173

# ── Demo seed (npm run seed) ────────────────────────────────
# Change these before any deployment that is reachable from outside.
DEMO_SUPER_ADMIN_EMAIL=superadmin@cybermilo.test
DEMO_SUPER_ADMIN_PASSWORD=CyberMilo@123
DEMO_SCHOOL_ADMIN_EMAIL=admin@greenvalley.test
DEMO_SCHOOL_ADMIN_PASSWORD=SchoolAdmin@123
