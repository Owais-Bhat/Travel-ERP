# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# build output
dist/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.production

# deployment archives (regenerated by the deploy scripts, not source)
deploy/*.zip

# typescript
*.tsbuildinfo

# uploaded documents (served from the API, not source)
backend/uploads/

# tooling scratch
.omc/
