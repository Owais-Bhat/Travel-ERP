# ============================================================
# CyberMilo web app — environment
#
# Copy to .env. Everything prefixed VITE_ is compiled into the browser
# bundle and is therefore public — never put a secret here.
# ============================================================

# Backend API. Include the /api suffix.
VITE_API_URL=http://localhost:5000/api

# Reserved for the realtime channel; unused while notifications poll.
VITE_WS_URL=http://localhost:5000

# ── AI (OpenRouter) ─────────────────────────────────────────
# Development only. A VITE_-prefixed key ships to every browser and can be
# drained by anyone who opens devtools — proxy AI calls through the backend
# before going to production.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/auto
